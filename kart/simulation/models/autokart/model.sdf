<?xml version="1.0"?>
<sdf version="1.7">
  <!-- SIMULATION USE ONLY — all dimensions/poses MEASUREMENT REQUIRED. -->
  <model name="autokart">
    <!-- Initial integration is a kinematic visual/sensor follower; Gazebo does not integrate kart motion. -->
    <static>true</static>
    <self_collide>false</self_collide>
    <link name="base_link">
      <inertial><pose>0.05 0 0.30 0 0 0</pose><mass>96</mass><inertia><ixx>24</ixx><iyy>35</iyy><izz>35</izz></inertia></inertial>
      <collision name="reviewed_primitive_collision"><pose>0.05 0 0.30 0 0 0</pose><geometry><box><size>1.75 1.06 0.16</size></box></geometry></collision>
      <visual name="chassis"><pose>0.05 0 0.30 0 0 0</pose><geometry><box><size>1.75 1.06 0.16</size></box></geometry><material><ambient>0.12 0.14 0.16 1</ambient><diffuse>0.18 0.20 0.22 1</diffuse></material></visual>
      <visual name="nose"><pose>0.60 0 0.42 0 0 0</pose><geometry><box><size>0.55 0.88 0.18</size></box></geometry><material><ambient>0.85 0.08 0.04 1</ambient><diffuse>0.9 0.1 0.05 1</diffuse></material></visual>
    </link>
    <link name="front_left_steer_link"><pose relative_to="base_link">0.575 0.475 0.14 0 0 0</pose><inertial><mass>.8</mass><inertia><ixx>.01</ixx><iyy>.01</iyy><izz>.01</izz></inertia></inertial><collision name="collision"><geometry><box><size>.10 .08 .16</size></box></geometry></collision><visual name="visual"><geometry><box><size>.10 .08 .16</size></box></geometry></visual></link>
    <link name="front_right_steer_link"><pose relative_to="base_link">0.575 -0.475 0.14 0 0 0</pose><inertial><mass>.8</mass><inertia><ixx>.01</ixx><iyy>.01</iyy><izz>.01</izz></inertia></inertial><collision name="collision"><geometry><box><size>.10 .08 .16</size></box></geometry></collision><visual name="visual"><geometry><box><size>.10 .08 .16</size></box></geometry></visual></link>
    <link name="front_left_wheel_link"><pose relative_to="front_left_steer_link">0 0 0 1.570796 0 0</pose><inertial><mass>2.2</mass><inertia><ixx>.025</ixx><iyy>.012</iyy><izz>.025</izz></inertia></inertial><collision name="collision"><geometry><cylinder><radius>.14</radius><length>.10</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>.14</radius><length>.10</length></cylinder></geometry><material><ambient>.02 .02 .02 1</ambient></material></visual></link>
    <link name="front_right_wheel_link"><pose relative_to="front_right_steer_link">0 0 0 1.570796 0 0</pose><inertial><mass>2.2</mass><inertia><ixx>.025</ixx><iyy>.012</iyy><izz>.025</izz></inertia></inertial><collision name="collision"><geometry><cylinder><radius>.14</radius><length>.10</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>.14</radius><length>.10</length></cylinder></geometry><material><ambient>.02 .02 .02 1</ambient></material></visual></link>
    <link name="rear_axle_link"><pose relative_to="base_link">-0.575 0 0.14 1.570796 0 0</pose><inertial><mass>3</mass><inertia><ixx>.12</ixx><iyy>.12</iyy><izz>.12</izz></inertia></inertial><collision name="collision"><geometry><cylinder><radius>.025</radius><length>.92</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>.025</radius><length>.92</length></cylinder></geometry></visual></link>
    <link name="rear_left_wheel_link"><pose relative_to="base_link">-0.575 0.46 0.14 1.570796 0 0</pose><inertial><mass>2.4</mass><inertia><ixx>.025</ixx><iyy>.012</iyy><izz>.025</izz></inertia></inertial><collision name="collision"><geometry><cylinder><radius>.14</radius><length>.10</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>.14</radius><length>.10</length></cylinder></geometry></visual></link>
    <link name="rear_right_wheel_link"><pose relative_to="base_link">-0.575 -0.46 0.14 1.570796 0 0</pose><inertial><mass>2.4</mass><inertia><ixx>.025</ixx><iyy>.012</iyy><izz>.025</izz></inertia></inertial><collision name="collision"><geometry><cylinder><radius>.14</radius><length>.10</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>.14</radius><length>.10</length></cylinder></geometry></visual></link>
    <link name="camera_link"><pose relative_to="base_link">0.64 0 0.72 0 0 0</pose><inertial><mass>.2</mass><inertia><ixx>.001</ixx><iyy>.001</iyy><izz>.001</izz></inertia></inertial><sensor name="rgb_camera" type="camera"><always_on>true</always_on><visualize>true</visualize><update_rate>30</update_rate><camera><horizontal_fov>1.3962634</horizontal_fov><image><width>320</width><height>240</height><format>R8G8B8</format></image><clip><near>.05</near><far>80</far></clip><noise><type>gaussian</type><stddev>.01</stddev></noise></camera><plugin name="autokart_rgb_delivery" filename="libautokart_gazebo_sensor_delivery.so"><sensor_id>rgb_camera</sensor_id><frame_id>camera_optical_frame</frame_id><ros_topic>/sensors/camera/image</ros_topic><metadata_topic>/sensors/delivery_metadata</metadata_topic><processing_latency_s>.008</processing_latency_s><transport_latency_s>.002</transport_latency_s><queue_capacity>4</queue_capacity><calibration_version>SIM-CAMERA-1</calibration_version></plugin></sensor></link>
    <link name="depth_camera_link"><pose relative_to="base_link">0.60 0 0.64 0 0 0</pose><inertial><mass>.25</mass><inertia><ixx>.001</ixx><iyy>.001</iyy><izz>.001</izz></inertia></inertial><sensor name="depth_camera" type="depth"><always_on>true</always_on><visualize>true</visualize><update_rate>30</update_rate><camera><horizontal_fov>1.3962634</horizontal_fov><image><width>320</width><height>240</height><format>R8G8B8</format></image><clip><near>.2</near><far>20</far></clip></camera><plugin name="autokart_depth_delivery" filename="libautokart_gazebo_sensor_delivery.so"><sensor_id>depth_camera</sensor_id><frame_id>depth_camera_optical_frame</frame_id><ros_topic>/sensors/depth/image</ros_topic><metadata_topic>/sensors/delivery_metadata</metadata_topic><processing_latency_s>.010</processing_latency_s><transport_latency_s>.002</transport_latency_s><queue_capacity>4</queue_capacity><calibration_version>SIM-DEPTH-1</calibration_version></plugin></sensor></link>
    <link name="lidar_link"><pose relative_to="base_link">0.20 0 0.82 0 0 0</pose><inertial><mass>.6</mass><inertia><ixx>.002</ixx><iyy>.002</iyy><izz>.002</izz></inertia></inertial><sensor name="lidar" type="ray"><always_on>true</always_on><visualize>true</visualize><update_rate>20</update_rate><ray><scan><horizontal><samples>1080</samples><resolution>1</resolution><min_angle>-2.356194</min_angle><max_angle>2.356194</max_angle></horizontal></scan><range><min>.05</min><max>30</max><resolution>.01</resolution></range><noise><type>gaussian</type><stddev>.01</stddev></noise></ray><plugin name="autokart_lidar_delivery" filename="libautokart_gazebo_sensor_delivery.so"><sensor_id>lidar</sensor_id><frame_id>lidar_link</frame_id><ros_topic>/sensors/lidar/scan</ros_topic><metadata_topic>/sensors/delivery_metadata</metadata_topic><processing_latency_s>.004</processing_latency_s><transport_latency_s>.002</transport_latency_s><queue_capacity>8</queue_capacity><calibration_version>SIM-LIDAR-1</calibration_version></plugin></sensor></link>
    <link name="imu_link"><pose relative_to="base_link">0.05 0 0.30 0 0 0</pose><inertial><mass>.1</mass><inertia><ixx>.0001</ixx><iyy>.0001</iyy><izz>.0001</izz></inertia></inertial><sensor name="imu" type="imu"><always_on>true</always_on><update_rate>200</update_rate><imu><angular_velocity><x><noise type="gaussian"><stddev>.002</stddev></noise></x></angular_velocity><linear_acceleration><x><noise type="gaussian"><stddev>.03</stddev></noise></x></linear_acceleration></imu></sensor></link>
    <joint name="front_left_steering_joint" type="revolute"><parent>base_link</parent><child>front_left_steer_link</child><axis><xyz>0 0 1</xyz><limit><lower>-.558505</lower><upper>.558505</upper><effort>300</effort><velocity>3</velocity></limit></axis></joint>
    <joint name="front_right_steering_joint" type="revolute"><parent>base_link</parent><child>front_right_steer_link</child><axis><xyz>0 0 1</xyz><limit><lower>-.558505</lower><upper>.558505</upper><effort>300</effort><velocity>3</velocity></limit></axis></joint>
    <joint name="front_left_wheel_joint" type="revolute"><parent>front_left_steer_link</parent><child>front_left_wheel_link</child><axis><xyz>0 1 0</xyz><limit><effort>200</effort><velocity>150</velocity></limit></axis></joint>
    <joint name="front_right_wheel_joint" type="revolute"><parent>front_right_steer_link</parent><child>front_right_wheel_link</child><axis><xyz>0 1 0</xyz><limit><effort>200</effort><velocity>150</velocity></limit></axis></joint>
    <joint name="rear_solid_axle_joint" type="revolute"><parent>base_link</parent><child>rear_axle_link</child><axis><xyz>0 1 0</xyz><dynamics><damping>.2</damping></dynamics></axis></joint>
    <joint name="rear_left_wheel_rigid_joint" type="fixed"><parent>rear_axle_link</parent><child>rear_left_wheel_link</child></joint>
    <joint name="rear_right_wheel_rigid_joint" type="fixed"><parent>rear_axle_link</parent><child>rear_right_wheel_link</child></joint>
    <joint name="camera_mount" type="fixed"><parent>base_link</parent><child>camera_link</child></joint>
    <joint name="depth_camera_mount" type="fixed"><parent>base_link</parent><child>depth_camera_link</child></joint>
    <joint name="lidar_mount" type="fixed"><parent>base_link</parent><child>lidar_link</child></joint>
    <joint name="imu_mount" type="fixed"><parent>base_link</parent><child>imu_link</child></joint>
    <plugin name="autokart_gazebo_follower" filename="libautokart_gazebo_follower.so">
      <physics_authority>internal</physics_authority>
      <gazebo_role>visual_sensor_follower</gazebo_role>
      <maximum_state_age_s>.020</maximum_state_age_s>
      <maximum_position_error_m>.005</maximum_position_error_m>
      <maximum_orientation_error_rad>.005</maximum_orientation_error_rad>
      <maximum_joint_error_rad>.005</maximum_joint_error_rad>
      <maximum_wheel_error_rad>.020</maximum_wheel_error_rad>
      <maximum_clock_offset_s>.002</maximum_clock_offset_s>
      <maximum_wall_snapshot_gap_s>.5</maximum_wall_snapshot_gap_s>
    </plugin>
    <!-- Read-only follower only: no drive, steering, brake, torque or contact-feedback plugin. -->
  </model>
</sdf>
